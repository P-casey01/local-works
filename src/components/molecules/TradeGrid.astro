---
import { TRADES } from '../../lib/trades';

interface Props {
  limit?: number;
  class?: string;
}

const { limit, class: className = '' } = Astro.props;
const displayTrades = limit ? TRADES.slice(0, limit) : TRADES;
---

<div class={`grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 md:gap-4 ${className}`}>
  {displayTrades.map(trade => {
    const article = 'AEIOUaeiou'.includes(trade.name[0]) ? 'an' : 'a';
    return (
    <a href={`/chat?trade=${trade.slug}`} class="block group" aria-label={`Find ${article} ${trade.name}`}>
      <div class="trade-card">
        <div class="trade-card-icon">
          <span class="material-symbols-rounded" style={`color: ${trade.color}`} aria-hidden="true">{trade.icon}</span>
        </div>
        <p class="trade-card-name">{trade.name}</p>
        <p class="trade-card-tagline">{trade.tagline}</p>
      </div>
    </a>
    );
  })}
</div>

<style>
  .trade-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 20px 12px 16px;
    text-align: center;
    transition: box-shadow 0.2s, border-color 0.2s;
  }
  .trade-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--color-border-light);
  }
  .trade-card-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 10px;
    background: var(--color-surface-variant);
  }
  .trade-card-icon .material-symbols-rounded {
    font-size: 20px;
  }
  .trade-card-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.3;
    margin-bottom: 4px;
  }
  .trade-card-tagline {
    font-size: 13px;
    font-weight: 400;
    color: var(--color-text-tertiary);
    line-height: 1.4;
  }
</style>