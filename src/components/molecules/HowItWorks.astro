---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const steps = [
  { icon: 'chat', title: '1. Chat', desc: 'Tell our bot what you need — trade, location, urgency' },
  { icon: 'person_search', title: '2. Match', desc: 'We find the best local pros for your specific job' },
  { icon: 'phone_in_talk', title: '3. Connect', desc: 'Contact your matched pro directly and get it sorted' },
];
---

<div class={`flex flex-col md:flex-row gap-3 ${className}`}>
  {steps.map(step => (
    <div class="flex-1 bg-[var(--color-surface)] rounded-lg p-3 text-center shadow-[var(--shadow-sm)]">
      <div class="w-[52px] h-[52px] rounded-full mx-auto mb-2 flex items-center justify-center bg-[var(--color-primary)]/[0.08]">
        <span class="material-symbols-rounded text-[28px] text-[var(--color-primary)]" aria-hidden="true">{step.icon}</span>
      </div>
      <p class="text-[13px] font-semibold text-[var(--color-text-primary)] mb-0.5">{step.title}</p>
      <p class="text-[13px] text-[var(--color-text-tertiary)] leading-snug">{step.desc}</p>
    </div>
  ))}
</div>