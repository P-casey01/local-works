---
---

<section class="bg-[var(--color-primary)] overflow-hidden">
  <div class="container py-16 md:py-24">
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
      <!-- Left: Copy -->
      <div class="flex-1 text-center lg:text-left">
        <h1 class="text-hero text-[var(--color-text-inverse)] mb-4">
          Find reliable local tradespeople without chasing quotes, missed calls, or uncertainty.
        </h1>
        <p class="text-body-lg text-[#B0C4DE] mb-8 max-w-xl mx-auto lg:mx-0">
          Post the job, compare verified providers, and book with confidence.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3">
          <a href="/chat" class="btn-primary text-[15px] px-7 py-3.5">
            Post a Job
          </a>
          <a href="/signup" class="bg-white/15 hover:bg-white/25 text-white font-semibold rounded-md px-7 py-3.5 text-[15px] transition-colors border border-white/20">
            Join as a Tradesperson
          </a>
        </div>
      </div>

      <!-- Right: App Preview Mockup -->
      <div class="flex-1 max-w-sm w-full">
        <div class="bg-white rounded-xl shadow-lg overflow-hidden border border-[#E5E7EB]">
          <!-- Mockup header -->
          <div class="bg-[#F3F4F6] px-5 py-3 border-b border-[#E5E7EB] flex items-center gap-2">
            <span class="material-symbols-rounded text-[18px] text-[var(--color-accent)]" aria-hidden="true">work</span>
            <span class="text-[14px] font-semibold text-[var(--color-text-primary)]">Job Details</span>
          </div>
          <!-- Mockup content -->
          <div class="px-5 py-4 space-y-3">
            <div>
              <p class="text-[11px] font-semibold text-[var(--color-text-muted)] uppercase tracking-wider mb-0.5">Job Title</p>
              <p class="text-[14px] font-medium text-[var(--color-text-primary)]">Bathroom renovation — full refit</p>
            </div>
            <div class="flex gap-4">
              <div class="flex-1">
                <p class="text-[11px] font-semibold text-[var(--color-text-muted)] uppercase tracking-wider mb-0.5">Location</p>
                <p class="text-[14px] text-[var(--color-text-secondary)]">BT7, Belfast</p>
              </div>
              <div class="flex-1">
                <p class="text-[11px] font-semibold text-[var(--color-text-muted)] uppercase tracking-wider mb-0.5">Trade</p>
                <p class="text-[14px] text-[var(--color-text-secondary)]">Plumber</p>
              </div>
            </div>
            <div class="border-t border-[#E5E7EB] pt-3">
              <p class="text-[11px] font-semibold text-[var(--color-text-muted)] uppercase tracking-wider mb-1">Matched Provider</p>
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-[#E0ECFF] flex items-center justify-center">
                  <span class="text-[14px] font-bold text-[var(--color-accent)]">JM</span>
                </div>
                <div class="flex-1">
                  <p class="text-[14px] font-semibold text-[var(--color-text-primary)]">John M. — Verified Plumber</p>
                  <div class="flex items-center gap-2 mt-0.5">
                    <span class="text-[12px] text-[#F59E0B]">★★★★★</span>
                    <span class="text-[12px] text-[var(--color-text-tertiary)]">4.9 (127 reviews)</span>
                  </div>
                </div>
                <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-[#059669] bg-[#ECFDF5] px-2 py-0.5 rounded-full">
                  <span class="material-symbols-rounded text-[14px]" aria-hidden="true">verified</span>
                  Verified
                </span>
              </div>
            </div>
            <div class="flex items-center justify-between border-t border-[#E5E7EB] pt-3">
              <span class="text-[12px] font-medium text-[var(--color-text-tertiary)]">Quote Status</span>
              <span class="inline-flex items-center gap-1 text-[12px] font-semibold text-[var(--color-accent)]">
                <span class="w-2 h-2 rounded-full bg-[#3B82F6]"></span>
                3 quotes received
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Trust Row -->
    <div class="flex flex-wrap items-center justify-center lg:justify-start gap-x-8 gap-y-2 mt-10 text-[13px] text-[#B0C4DE]">
      <span class="flex items-center gap-1.5">
        <span class="material-symbols-rounded text-[16px]" aria-hidden="true">verified_user</span>
        Verified provider profiles
      </span>
      <span class="flex items-center gap-1.5">
        <span class="material-symbols-rounded text-[16px]" aria-hidden="true">shield</span>
        Insurance & certification checks
      </span>
      <span class="flex items-center gap-1.5">
        <span class="material-symbols-rounded text-[16px]" aria-hidden="true">star</span>
        Reviewed by real customers
      </span>
      <span class="flex items-center gap-1.5">
        <span class="material-symbols-rounded text-[16px]" aria-hidden="true">forum</span>
        Clear job history & communication
      </span>
    </div>
  </div>
</section>