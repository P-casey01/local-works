---
const items = [
  { icon: 'verified_user', title: 'Certification checks', desc: 'All providers\' trade certifications are verified before profiles go live.' },
  { icon: 'shield', title: 'Public liability insurance', desc: 'Insurance status is visible on every provider profile.' },
  { icon: 'rate_review', title: 'Customer reviews', desc: 'Real reviews from verified customers you can trust.' },
  { icon: 'report', title: 'Report & dispute process', desc: 'Clear process if something goes wrong — we\'re here to help.' },
];
---

<section class="bg-[var(--color-surface)] section">
  <div class="container">
    <div class="text-center mb-8 md:mb-10">
      <h2 class="text-section-heading text-[var(--color-text-primary)] mb-3">Trust & Safety</h2>
      <p class="text-[var(--color-text-tertiary)] text-body-lg max-w-lg mx-auto">Every provider on Local Works is verified. Here's how we keep it that way.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {items.map(item => (
        <div class="card">
          <div class="w-10 h-10 rounded-full mb-3 flex items-center justify-center bg-[var(--color-accent)]/[0.08]">
            <span class="material-symbols-rounded text-[20px] text-[var(--color-accent)]" aria-hidden="true">{item.icon}</span>
          </div>
          <p class="text-card-heading text-[var(--color-text-primary)] mb-1.5">{item.title}</p>
          <p class="text-[14px] text-[var(--color-text-tertiary)] leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>