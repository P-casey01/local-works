---
interface Testimonial {
  name: string;
  location: string;
  quote: string;
  trade: string;
  rating: number;
}

const testimonials: Testimonial[] = [
  {
    name: 'Sarah M.',
    location: 'Belfast',
    quote: 'Needed an emergency plumber at 9pm — ServiceMatch had someone at my door within the hour. Absolutely brilliant.',
    trade: 'Plumber',
    rating: 5,
  },
  {
    name: 'Declan K.',
    location: 'Derry',
    quote: 'Found a great electrician through the chatbot. Rewired the whole kitchen, neat job, fair price. Will use again.',
    trade: 'Electrician',
    rating: 5,
  },
  {
    name: 'Fiona T.',
    location: 'Lisburn',
    quote: 'Was sceptical at first but the tradesperson they matched me with was top quality. Verified and insured — you can trust this service.',
    trade: 'Carpenter',
    rating: 4,
  },
];
---

<section>
  <h2 class="text-h3 text-[var(--color-text-primary)] mb-3">What People Say</h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    {testimonials.map(t => (
      <div class="bg-[var(--color-surface)] rounded-lg p-5 shadow-[var(--shadow-sm)]">
        <div class="flex gap-0.5 mb-2" aria-label={`${t.rating} out of 5 stars`}>
          {Array.from({ length: 5 }).map((_, i) => (
            <span class="text-[18px]" aria-hidden="true">{i < t.rating ? '⭐' : '☆'}</span>
          ))}
        </div>
        <p class="text-[15px] text-[var(--color-text-secondary)] leading-relaxed mb-3">"{t.quote}"</p>
        <div class="flex items-center gap-2 text-[13px]">
          <span class="font-semibold text-[var(--color-text-primary)]">{t.name}</span>
          <span class="text-[var(--color-text-muted)]">•</span>
          <span class="text-[var(--color-text-tertiary)]">{t.location}</span>
          <span class="text-[var(--color-text-muted)]">•</span>
          <span class="text-[var(--color-primary)] text-[12px] font-semibold">{t.trade}</span>
        </div>
      </div>
    ))}
  </div>
</section>