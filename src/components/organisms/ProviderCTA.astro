---
import Button from '../atoms/Button.astro';

interface Props {
  tradeName?: string;
}

const { tradeName } = Astro.props;
const title = tradeName ? `Are you a ${tradeName}?` : 'Are you a tradesperson?';
const desc = tradeName
  ? `Create your free profile and get matched with customers looking for ${tradeName}s in your area`
  : 'Create your free profile and get matched with customers in your area';
---

<section class="bg-[#EFF6FF] border border-[#DBEAFE] rounded-xl p-6 text-center">
  <span class="material-symbols-rounded text-4xl text-[var(--color-secondary)] mb-2" aria-hidden="true" style="font-variation-settings: 'FILL' 1;">badge</span>
  <h3 class="text-h3 text-[var(--color-text-primary)] mb-1">{title}</h3>
  <p class="text-body text-[var(--color-text-tertiary)] mb-4 max-w-[85%] mx-auto leading-relaxed">
    {desc}
  </p>
  <Button href="/signup" variant="outline" size="md" icon="→">
    Create Your Profile
  </Button>
</section>