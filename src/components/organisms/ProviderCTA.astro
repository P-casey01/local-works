---
const trustPoints = [
  'Free to join',
  'Verified profiles',
  'Local job matches',
];
---

<section class="provider-cta">
  <div class="container">
    <div class="cta-layout">
      <div class="cta-left">
        <span class="material-symbols-rounded cta-icon" aria-hidden="true">handshake</span>
        <h2 class="cta-heading">Are you a tradesperson?</h2>
        <p class="cta-subheading">Get found by local customers looking for your trade.</p>
        <p class="cta-body">Create a free profile, list your services, and receive matched job requests in your area.</p>
      </div>
      <div class="cta-right">
        <a href="/signup" class="btn-primary">Create Your Free Profile →</a>
        <div class="trust-chips">
          {trustPoints.map(point => (
            <span class="trust-chip">
              <span class="material-symbols-rounded check-icon" aria-hidden="true">check_circle</span>
              {point}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .provider-cta {
    padding-top: var(--space-section-mobile);
    padding-bottom: var(--space-section-mobile);
    background: var(--color-surface-variant);
  }
  @media (min-width: 768px) {
    .provider-cta {
      padding-top: var(--space-section);
      padding-bottom: var(--space-section);
    }
  }

  .cta-layout {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  @media (min-width: 768px) {
    .cta-layout {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      padding: 44px 48px;
      gap: 40px;
    }
  }

  .cta-left {
    max-width: 520px;
  }

  .cta-icon {
    font-size: 28px;
    color: var(--color-accent);
    margin-bottom: 12px;
    display: block;
  }

  .cta-heading {
    font-size: 24px;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.25;
    margin-bottom: 8px;
  }

  .cta-subheading {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text-secondary);
    line-height: 1.4;
    margin-bottom: 4px;
  }

  .cta-body {
    font-size: 16px;
    font-weight: 400;
    color: var(--color-text-tertiary);
    line-height: 1.5;
  }

  .cta-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    flex-shrink: 0;
  }
  @media (min-width: 768px) {
    .cta-right {
      align-items: center;
      padding-top: 8px;
    }
  }

  .trust-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .trust-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-tertiary);
  }

  .check-icon {
    font-size: 15px;
    color: var(--color-success);
  }
</style>