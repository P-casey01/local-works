---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'danger';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  class?: string;
  icon?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  class: className = '',
  icon,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';

const base = 'inline-flex items-center justify-center gap-2 font-semibold rounded-button transition-all duration-200 focus-visible:ring-2 focus-visible:ring-[var(--color-primary-light)] focus-visible:ring-offset-2 active:scale-[0.97] disabled:opacity-50 disabled:pointer-events-none';

const variants: Record<string, string> = {
  primary: 'bg-[var(--color-primary)] text-[var(--color-text-inverse)] shadow-[var(--shadow-primary)] hover:opacity-90',
  secondary: 'bg-[var(--color-secondary)] text-[var(--color-text-inverse)] hover:opacity-90',
  outline: 'bg-transparent text-[var(--color-primary)] border-1.5 border-[var(--color-primary)] hover:bg-[var(--color-info-light)]',
  ghost: 'bg-transparent text-[var(--color-primary)] hover:bg-[var(--color-info-light)]',
  danger: 'bg-[var(--color-danger)] text-[var(--color-text-inverse)] hover:opacity-90',
};

const sizes: Record<string, string> = {
  sm: 'px-3 py-2 text-[13px] font-semibold',
  md: 'px-5 py-3 text-[15px] font-semibold',
  lg: 'px-6 py-3.5 text-[15px] font-semibold',
};

const classes = `${base} ${variants[variant]} ${sizes[size]} ${className}`;
---

<Tag href={href} class={classes} {...rest}>
  {icon && <span class="text-lg" aria-hidden="true">{icon}</span>}
  <slot />
</Tag>