---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TradeGrid from '../../components/molecules/TradeGrid.astro';
import { TRADES } from '../../lib/trades';
---

<BaseLayout
  title="All Trades — Find Local Professionals"
  description="Browse all trades on ServiceMatch. Find vetted plumbers, electricians, carpenters and more in Northern Ireland."
>
  <div class="container py-6 md:py-8 space-y-8">
    <section class="text-center mb-4">
      <h1 class="text-h1 text-[var(--color-text-primary)] mb-2 tracking-tight font-extrabold">All Trades</h1>
      <p class="text-body text-[var(--color-text-secondary)] max-w-[600px] mx-auto leading-relaxed">
        Browse our full directory of vetted local professionals in Northern Ireland
      </p>
    </section>

    <TradeGrid />
  </div>
</BaseLayout>