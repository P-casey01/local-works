---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/atoms/Badge.astro';
import AvailabilityTag from '../../components/atoms/AvailabilityTag.astro';
import Button from '../../components/atoms/Button.astro';
import { getProvider, SAMPLE_PROVIDERS } from '../../lib/providers';
import { getTradeInfo, AVAILABILITY_LABELS } from '../../lib/trades';

export function getStaticPaths() {
  return SAMPLE_PROVIDERS.map(provider => ({
    params: { id: provider.id },
    props: { provider },
  }));
}

const { provider } = Astro.props;
const tradeInfo = getTradeInfo(provider.trade);
const tradeColor = tradeInfo?.color || 'var(--color-primary)';
const tradeIcon = tradeInfo?.icon || 'account-hard-hat';
const cleanPhone = provider.phone.replace(/\s/g, '');
---

<BaseLayout
  title={`${provider.name} — ${provider.trades.join(', ')} in ${provider.location}`}
  description={provider.bio}
  noindex={!provider.verified}
>
  <div class="container py-6 md:py-8 max-w-[800px] mx-auto space-y-4">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="mb-2">
      <ol class="flex items-center gap-2 text-[13px] text-[var(--color-text-tertiary)]">
        <li><a href="/" class="hover:text-[var(--color-primary)] transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={`/trades/${tradeInfo?.slug || ''}`} class="hover:text-[var(--color-primary)] transition-colors">{provider.trade}s</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-[var(--color-text-primary)] font-semibold" aria-current="page">{provider.name}</li>
      </ol>
    </nav>

    <!-- Header -->
    <div class="text-center py-6">
      <div class="w-20 h-20 rounded-full mx-auto mb-3 flex items-center justify-center" style={`background: color-mix(in srgb, ${tradeColor} 9%, transparent)`}>
        <span class="material-symbols-rounded text-[40px]" style={`color: ${tradeColor}`} aria-hidden="true">{tradeIcon}</span>
      </div>
      <h1 class="text-h1 text-[var(--color-text-primary)] tracking-tight">{provider.name}</h1>
      {provider.verified && (
        <div class="mt-1 mb-1">
          <Badge variant="success">✓ Verified Professional</Badge>
        </div>
      )}
      <p class="text-body-bold text-[var(--color-primary)]">{provider.trades.join(' • ')}</p>
    </div>

    <!-- Quick Stats -->
    <div class="flex gap-2">
      <div class="flex-1 bg-[var(--color-surface)] rounded-md p-4 text-center shadow-[var(--shadow-sm)]">
        <p class="text-h4 text-[var(--color-text-primary)]">⭐ {provider.rating}</p>
        <p class="text-overline text-[var(--color-text-muted)] mt-0.5">{provider.reviewCount} reviews</p>
      </div>
      <div class="flex-1 bg-[var(--color-surface)] rounded-md p-4 text-center shadow-[var(--shadow-sm)]">
        <p class="text-h4 text-[var(--color-primary)]">£{provider.hourlyRate}/hr</p>
        <p class="text-overline text-[var(--color-text-muted)] mt-0.5">Hourly rate</p>
      </div>
      <div class="flex-1 bg-[var(--color-surface)] rounded-md p-4 text-center shadow-[var(--shadow-sm)]">
        <p class="text-h4 text-[var(--color-text-primary)]">{provider.completedJobs}</p>
        <p class="text-overline text-[var(--color-text-muted)] mt-0.5">Jobs done</p>
      </div>
    </div>

    <!-- Availability -->
    <div class="bg-[var(--color-surface)] rounded-lg p-4 shadow-[var(--shadow-sm)]">
      <h2 class="text-h4 text-[var(--color-text-primary)] mb-2">Availability</h2>
      <div class="flex justify-between items-center">
        <AvailabilityTag availability={provider.availability} />
        <span class="text-body text-[var(--color-text-tertiary)]">📍 {provider.location} • {provider.radius} mile radius</span>
      </div>
    </div>

    <!-- Skills -->
    <div class="bg-[var(--color-surface)] rounded-lg p-4 shadow-[var(--shadow-sm)]">
      <h2 class="text-h4 text-[var(--color-text-primary)] mb-2">Skills & Services</h2>
      <ul aria-label="Skills" class="flex flex-wrap gap-1.5 list-none p-0 m-0">
        {provider.skills.map(skill => (
          <li class="bg-[var(--color-info-light)] rounded-pill px-3 py-1 text-[13px] text-[var(--color-primary)] font-semibold">{skill}</li>
        ))}
      </ul>
    </div>

    <!-- About -->
    <div class="bg-[var(--color-surface)] rounded-lg p-4 shadow-[var(--shadow-sm)]">
      <h2 class="text-h4 text-[var(--color-text-primary)] mb-2">About</h2>
      <p class="text-body text-[var(--color-text-secondary)] leading-relaxed">{provider.bio}</p>
    </div>

    <!-- Contact -->
    <div class="flex flex-col md:flex-row gap-3 mt-4">
      <a href={`tel:${cleanPhone}`} class="flex-1 bg-[var(--color-primary)] rounded-button py-3.5 text-center shadow-[var(--shadow-primary)] hover:opacity-90 transition-opacity" aria-label={`Call ${provider.name}`}>
        <span class="text-body-bold text-[var(--color-text-inverse)]">📞  Call Now</span>
      </a>
      <a href={`mailto:${provider.email}`} class="flex-1 bg-[var(--color-surface)] rounded-button py-3.5 text-center border-1.5 border-[var(--color-primary)] hover:bg-[var(--color-info-light)] transition-colors" aria-label={`Email ${provider.name}`}>
        <span class="text-body-bold text-[var(--color-primary)]">✉️  Send Email</span>
      </a>
    </div>

    <!-- Disclaimer -->
    <p class="text-[13px] text-[var(--color-text-muted)] text-center leading-snug mt-2">
      Always verify credentials and qualifications before hiring. ServiceMatch connects you — you choose.
    </p>

    <!-- Browse more tradespeople -->
    <div class="bg-[var(--color-info-light)] rounded-lg p-4 text-center mt-4">
      <p class="text-body text-[var(--color-text-secondary)] mb-2">Looking for more {provider.trade}s in {provider.location}?</p>
      <a href={`/trades/${tradeInfo?.slug || ''}`} class="text-body-bold text-[var(--color-primary)] hover:opacity-80 transition-opacity">
        Browse all {provider.trade}s →
      </a>
    </div>

    <!-- JSON-LD: LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": provider.name,
      "description": provider.bio,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": provider.location,
        "addressRegion": "Northern Ireland",
        "addressCountry": "GB"
      },
      "telephone": cleanPhone,
      "email": provider.email,
      "priceRange": `£${provider.hourlyRate}/hr`,
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": provider.rating,
        "reviewCount": provider.reviewCount
      },
    })} />
  </div>
</BaseLayout>